# ── LLM Backend ────────────────────────────────────────────────────────────
# mock | anthropic | ollama | bedrock
LLM_BACKEND=ollama

# Anthropic (only needed if LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama — self-hosted on host machine
# Local (outside Docker): http://localhost:11434
# Inside Docker:          http://host.docker.internal:11434  ← docker-compose default
OLLAMA_BASE_URL=http://localhost:11434

# ── PII Backend ────────────────────────────────────────────────────────────
# regex (default, zero deps) | presidio (local NLP) | comprehend (AWS)
PII_BACKEND=regex

# ── Budget Backend ─────────────────────────────────────────────────────────
# sqlite (default) | dynamodb (AWS)
BUDGET_BACKEND=sqlite
BUDGET_DB_PATH=budget.db

# ── Audit Backend ──────────────────────────────────────────────────────────
# jsonl (default) | cloudwatch (AWS) | memory (tests only)
AUDIT_BACKEND=jsonl
AUDIT_LOG_PATH=audit.jsonl

# ── App Registry ───────────────────────────────────────────────────────────
APP_REGISTRY_PATH=app_registry.yaml

# ── AWS (only for Bedrock / Comprehend / DynamoDB / CloudWatch backends) ───
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
